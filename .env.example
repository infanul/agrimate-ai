# ==========================================
# AgriMate AI - Root Environment Blueprint
# ==========================================

# ------------------------------------------
# Server Settings (Render Backend Deployment)
# ------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=agrimate_jwt_secret_key_production_ready_2026_super_secure

# Database Connection (Render Postgres / Supabase / Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrimate_db?schema=public"

# Allowed Client Origin for CORS (Vercel Frontend URL)
CLIENT_URL="https://agrimate-ai.vercel.app"

# ------------------------------------------
# Frontend Settings (Vercel Frontend Deployment)
# ------------------------------------------
# Set this in Vercel Environment Variables:
NEXT_PUBLIC_API_URL="https://agrimate-ai-backend.onrender.com/api"
