generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Crop {
  id              Int       @id @default(autoincrement())
  name            String
  type            String
  plantingDate    DateTime
  expectedHarvest DateTime?
  farmerId        Int

  // Relations
  weatherAlerts      WeatherAlert[]
  cropCalendarEvents CropCalendarEvent[]
}

model Soil {
  id       Int    @id @default(autoincrement())
  type     String
  ph       Float?
  moisture Float?
  location String
}

model Expense {
  id       Int      @id @default(autoincrement())
  farmerId Int
  category String
  amount   Float
  date     DateTime
}

model WeatherAlert {
  id          Int      @id @default(autoincrement())
  cropId      Int
  title       String
  description String
  severity    String
  dateIssued  DateTime @default(now())

  crop Crop @relation(fields: [cropId], references: [id])
}

model CropCalendarEvent {
  id          Int       @id @default(autoincrement())
  cropId      Int
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  status      String
  priority    String

  crop Crop @relation(fields: [cropId], references: [id])
}
